        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "html": "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Karuzela opinii klientów</title>\n\n<style>\nbody {\n  font-family: Arial, sans-serif;\n  background: #4B0082;\n  padding: 40px 0;\n  margin: 0;\n}\n\n.avis-container {\n  overflow: hidden;\n  width: 100%;\n}\n\n.avis-carousel {\n  display: flex;\n  gap: 20px;\n  animation: scroll 60s linear infinite; /* ralenti */\n  width: max-content;\n}\n\n.avis-slide {\n  flex: 0 0 350px;\n}\n\n.avis-card {\n  background: rgba(75, 0, 130, 0.2);\n  border: 1px solid rgba(255,255,255,0.3);\n  border-radius: 8px;\n  padding: 20px;\n  display: flex;\n}\n\n.avis-content {\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  width: 100%;\n}\n\n.avis-header {\n  display: flex;\n  gap: 15px;\n}\n\n.avis-photo {\n  width: 60px;\n  height: 60px;\n  border-radius: 8px;\n  object-fit: cover;\n}\n\n.avis-texte {\n  font-size: 14px;\n  color: #fff;\n  font-weight: bold;\n}\n\n.avis-separateur {\n  margin: 15px 0;\n  height: 1px;\n  background: rgba(255,255,255,0.2);\n  border: none;\n}\n\n.avis-nom {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  color: #fff;\n  font-weight: bold;\n}\n\n.etoiles-image {\n  height: 18px;\n}\n\n@keyframes scroll {\n  0% { transform: translateX(0); }\n  100% { transform: translateX(-50%); }\n}\n</style>\n\n\n\n\n<div class=\"avis-container\">\n  <div class=\"avis-carousel\">\n\n    <!-- ===== SLIDES ===== -->\n\n    <!-- 1 -->\n    <div class=\"avis-slide\">\n      <div class=\"avis-card\">\n        <div class=\"avis-content\">\n          <div class=\"avis-header\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0961/2833/6258/files/IMG_0997.jpg?v=1774906357\" class=\"avis-photo\">\n            <p class=\"avis-texte\">Codziennie piję kawę i moje zęby się przebarwiły. Efekt po kilku użyciach naprawdę mnie zaskoczył.</p>\n          </div>\n          <hr class=\"avis-separateur\">\n          <p class=\"avis-nom\">\n            <span>Michał K.</span>\n            <img src=\"https://cdn.shopify.com/s/files/1/0743/9217/4859/files/4.5-stars-trustpilot_2157d8d9-101e-46a2-a3fe-ac80f2fecf10.png\" class=\"etoiles-image\">\n          </p>\n        </div>\n      </div>\n    </div>\n\n    <!-- 2 -->\n    <div class=\"avis-slide\">\n      <div class=\"avis-card\">\n        <div class=\"avis-content\">\n          <div class=\"avis-header\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0961/2833/6258/files/IMG_0998.jpg?v=1774906357\" class=\"avis-photo\">\n            <p class=\"avis-texte\">Miałam kompleks przez uśmiech. Teraz czuję się pewniej każdego dnia.</p>\n          </div>\n          <hr class=\"avis-separateur\">\n          <p class=\"avis-nom\">\n            <span>Agnieszka W.</span>\n            <img src=\"https://cdn.shopify.com/s/files/1/0743/9217/4859/files/4.5-stars-trustpilot_2157d8d9-101e-46a2-a3fe-ac80f2fecf10.png\" class=\"etoiles-image\">\n          </p>\n        </div>\n      </div>\n    </div>\n\n    <!-- 3 -->\n    <div class=\"avis-slide\">\n      <div class=\"avis-card\">\n        <div class=\"avis-content\">\n          <div class=\"avis-header\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0961/2833/6258/files/IMG_0996.jpg?v=1774906356\" class=\"avis-photo\">\n            <p class=\"avis-texte\">Użyłem ich przed randką 😅 Proste i skuteczne.</p>\n          </div>\n          <hr class=\"avis-separateur\">\n          <p class=\"avis-nom\">\n            <span>Karolina P.</span>\n            <img src=\"https://cdn.shopify.com/s/files/1/0743/9217/4859/files/4.5-stars-trustpilot_2157d8d9-101e-46a2-a3fe-ac80f2fecf10.png\" class=\"etoiles-image\">\n          </p>\n        </div>\n      </div>\n    </div>\n\n    <!-- 4 -->\n    <div class=\"avis-slide\">\n      <div class=\"avis-card\">\n        <div class=\"avis-content\">\n          <div class=\"avis-header\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0961/2833/6258/files/IMG_0995.jpg?v=1774906357\" class=\"avis-photo\">\n            <p class=\"avis-texte\">Pierwszy raz widzę realną poprawę koloru zębów.</p>\n          </div>\n          <hr class=\"avis-separateur\">\n          <p class=\"avis-nom\">\n            <span>Magdalena K.</span>\n            <img src=\"https://cdn.shopify.com/s/files/1/0743/9217/4859/files/4.5-stars-trustpilot_2157d8d9-101e-46a2-a3fe-ac80f2fecf10.png\" class=\"etoiles-image\">\n          </p>\n        </div>\n      </div>\n    </div>\n\n    <!-- ===== DUPLICATION (clé du loop infini) ===== -->\n\n    <!-- 1 -->\n    <div class=\"avis-slide\">\n      <div class=\"avis-card\"><div class=\"avis-content\">\n<div class=\"avis-header\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0961/2833/6258/files/IMG_0997.jpg?v=1774906357\" class=\"avis-photo\">\n        <p class=\"avis-texte\">Codziennie piję kawę i moje zęby się przebarwiły. Efekt po kilku użyciach naprawdę mnie zaskoczył.</p>\n      </div>\n<hr class=\"avis-separateur\">\n<p class=\"avis-nom\"><span>Michał K.</span>\n      <img src=\"https://cdn.shopify.com/s/files/1/0743/9217/4859/files/4.5-stars-trustpilot_2157d8d9-101e-46a2-a3fe-ac80f2fecf10.png\" class=\"etoiles-image\"></p>\n</div></div>\n    </div>\n\n    <!-- 2 -->\n    <div class=\"avis-slide\">\n      <div class=\"avis-card\"><div class=\"avis-content\">\n<div class=\"avis-header\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0961/2833/6258/files/IMG_0998.jpg?v=1774906357\" class=\"avis-photo\">\n        <p class=\"avis-texte\">Miałam kompleks przez uśmiech. Teraz czuję się pewniej każdego dnia.</p>\n      </div>\n<hr class=\"avis-separateur\">\n<p class=\"avis-nom\"><span>Agnieszka W.</span>\n      <img src=\"https://cdn.shopify.com/s/files/1/0743/9217/4859/files/4.5-stars-trustpilot_2157d8d9-101e-46a2-a3fe-ac80f2fecf10.png\" class=\"etoiles-image\"></p>\n</div></div>\n    </div>\n\n    <!-- 3 -->\n    <div class=\"avis-slide\">\n      <div class=\"avis-card\"><div class=\"avis-content\">\n<div class=\"avis-header\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0961/2833/6258/files/IMG_0996.jpg?v=1774906356\" class=\"avis-photo\">\n        <p class=\"avis-texte\">Użyłem ich przed randką 😅 Proste i skuteczne.</p>\n      </div>\n<hr class=\"avis-separateur\">\n<p class=\"avis-nom\"><span>Karolina P.</span>\n      <img src=\"https://cdn.shopify.com/s/files/1/0743/9217/4859/files/4.5-stars-trustpilot_2157d8d9-101e-46a2-a3fe-ac80f2fecf10.png\" class=\"etoiles-image\"></p>\n</div></div>\n    </div>\n\n    <!-- 4 -->\n    <div class=\"avis-slide\">\n      <div class=\"avis-card\"><div class=\"avis-content\">\n<div class=\"avis-header\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0961/2833/6258/files/IMG_0995.jpg?v=1774906357\" class=\"avis-photo\">\n        <p class=\"avis-texte\">Pierwszy raz widzę realną poprawę koloru zębów.</p>\n      </div>\n<hr class=\"avis-separateur\">\n<p class=\"avis-nom\"><span>Magdalena K.</span>\n      <img src=\"https://cdn.shopify.com/s/files/1/0743/9217/4859/files/4.5-stars-trustpilot_2157d8d9-101e-46a2-a3fe-ac80f2fecf10.png\" class=\"etoiles-image\"></p>\n</div></div>\n    </div>\n\n  </div>\n</div>",

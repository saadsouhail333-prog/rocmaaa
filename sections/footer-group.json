        "testimonial_q74pYA": {
          "type": "testimonial",
          "settings": {
            "round_avatar": true,
            "show_rating": true,
            "rating": 4,
            "author": "Piotr Zieliński",
            "title": "",
            "content": "<p><br/><strong>Nawet myjąc zęby rano i wieczorem, moje zęby pozostawały lekko żółte. Myślałam, że to kwestia genetyki. Po raz pierwszy widzę prawdziwą poprawę.</strong></p>"
          }
        },
        "testimonial_ceK4JA": {
          "type": "testimonial",
          "settings": {
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Łukasz Kowalczyk",
            "title": "",
            "content": "<p><strong>Próbowałem węgla, kilku wybielających past do zębów, innych marek… bez prawdziwego efektu. Tutaj, już przy pierwszym użyciu zobaczyłem prawdziwą różnicę. Od razu mnie to przekonało.</strong></p>"
          }
        },
        "testimonial_NxyAnX": {
          "type": "testimonial",
          "settings": {
            "round_avatar": true,
